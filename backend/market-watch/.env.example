# ============================================================
# market-watch 盘中盯盘 Agent 配置（复制为 .env 后编辑）
# 环境变量前缀 MW_，与 dsh-trading-core 的 BRIEF_* 区分。
# 推送凭据复用同名变量，可与 trading-core 共用同一份 key。
# 产品内通过 Profile 使用时，只在现有 Models 页面管理 Key；不要为产品使用复制或填写 backend .env。
# backend .env 仅用于 Python 独立启动或兼容开发，且宿主注入的进程环境变量优先。
# ============================================================

# ---------- LLM（可选，但简报/新闻摘要/触发解读需要） ----------
# 关闭则盯盘核心照常跑，仅 LLM 能力降级为数据模板
MW_LLM_ENABLED=false
MW_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 外部推送（触发告警 / 新闻速递 / 简报） ----------
# 全部默认关闭；任一发送渠道配好 key 后开启
MW_PUSH_ENABLED=false
# 逗号分隔，限制启用哪些通道（serverchan / wecom）；留空=配了 key 的通道全启用
MW_PUSH_CHANNELS=
SERVERCHAN_SENDKEY=
WECOM_WEBHOOK_KEY=

# ---------- 调度 ----------
# 总开关：false 则所有定时 job 不挂（手动 tick 仍可用）
MW_SCHEDULE_ENABLED=true
# 盘中规则评估轮询间隔（秒），默认 30
MW_POLL_INTERVAL=30

# ---------- 行情数据 ----------
# 实时快照缓存秒数。快照=整市分页拉取(55+请求)，TTL 太短会高频打爆东财 push2 被限流。
# 盯盘触发用 60s 足够（精确到分钟级的条件评估）。
MW_QUOTE_CACHE_TTL=60
# 主力资金流缓存秒数 + 开关（逐股拉取较慢）
MW_FUND_FLOW_TTL=300
MW_FUND_FLOW=true
# 技术信号默认 K 线根数
MW_LOOKBACK_DAYS=120

# ---------- 新闻速递 ----------
# 财联社要闻 top N；每只自选个股新闻 top N
MW_NEWS_ENABLED=false
MW_NEWS_INTERVAL_MIN=60
MW_NEWS_TOP=8
MW_STOCK_NEWS_TOP=3

# ---------- 事件驱动 · 定向个股新闻 ----------
# 对持仓+自选逐只拉东财搜索新闻，直接标注已知 code，合并进 /news/events
# 拉取频率受 event_ttl(MW_EVENT_TTL) 限制，无需单独 TTL
MW_DIRECTED_NEWS_ENABLED=true
# 每只标的取 top N 条
MW_DIRECTED_NEWS_PER_STOCK=3
# 并发 worker 数（东财搜索接口，礼貌并发防限流）
MW_DIRECTED_NEWS_WORKERS=4
# 单请求 HTTP 超时（秒）
MW_DIRECTED_NEWS_TIMEOUT=2
# 一轮定向拉取的总预算（秒），超时返回部分结果
# 服务冷抽取时 flash/LLM 并行抢占网络，3s 内 5 只常只完成 2-3 只，默认放宽到 8s
MW_DIRECTED_NEWS_DEADLINE=8

# ---------- 盘前 / 盘后简报 ----------
MW_PRE_BRIEF_ENABLED=false
MW_PRE_BRIEF_TIME=08:50
MW_POST_BRIEF_ENABLED=false
MW_POST_BRIEF_TIME=15:30

# ---------- 时区 ----------
TIMEZONE=Asia/Shanghai

# ---------- 网络 ----------
# 关键！akshare 的 eastmoney 直连必须走 NO_PROXY，否则被系统代理断连。
# config.py import 时会 load_dotenv 注入，勿删 eastmoney.com。
NO_PROXY=eastmoney.com,push2.eastmoney.com,82.push2.eastmoney.com,127.0.0.1,localhost
