# ============================================================
# industry-chain 产业链图谱 Agent 配置（复制为 .env 后编辑）
# 环境变量前缀 IC_，独立于 dsh-trading-core / market-watch。
# ============================================================

# ---------- 服务 ----------
IC_HOST=127.0.0.1
IC_PORT=8200

# ---------- 数据 ----------
# 源码模式种子数据目录（默认 data/seed）。打包 Runtime 始终使用宿主可写状态目录。
# IC_DATA_DIR=data/seed

# ---------- 首次下载 ----------
# 用户确认首次下载与 fetch_seed_data.py 使用的固定数据源（iducsite 静态托管）
# IC_SEED_BASE_URL=https://villadora.github.io/iducsite/data

# ---------- 研报管线 LLM ----------
# 从 backend/dsh-trading-core/.env 复制 DEEPSEEK_API_KEY 到本文件（真实 key 只留本地 .env，不进 git）
# IC_DEEPSEEK_API_KEY=
# IC_LLM_MODEL=deepseek-chat
# IC_DEEPSEEK_BASE_URL=https://api.deepseek.com
