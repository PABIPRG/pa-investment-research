# dsh-trading-core 配置模板
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不会入库）
# 产品内通过 Profile 使用时，只在现有 Models 页面管理 Key；不要为产品使用复制或填写 backend .env。
# backend .env 仅用于 Python 独立启动或兼容开发，且宿主注入的进程环境变量优先。
# 完整可用的配置在旧项目 TradingAgents-CN/.env（含上游 app 用到的 MongoDB/Redis/定时同步等，
# 本插件只用下面这些子集；缺省项适配器会回退默认值）。

# ── LLM（DeepSeek，插件核心）──────────────────────────────────────
# 适配器用 openai 直连 DeepSeek，绕开 LangChain 层
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=true
# 引擎侧默认 provider 用 openai 兼容端点；engine_bridge 会显式覆盖为 DeepSeek
OPENAI_API_KEY=sk-你的key

# ── 风险偏好（全局默认档：conservative | balanced | aggressive）──
RISK_PROFILE=balanced

# ── A 股数据源 ────────────────────────────────────────────────────
DEFAULT_CHINA_DATA_SOURCE=akshare     # akshare | baostock | tushare
# TUSHARE_TOKEN=                        # 可选，tushare 数据源 token
# 国内行情站必须走直连（否则走代理会失败）
NO_PROXY=localhost,127.0.0.1,eastmoney.com,.eastmoney.com,gtimg.cn,sinaimg.cn,sinajs.cn,sina.com.cn,baostock.com

# ── 引擎记忆 / 缓存 ───────────────────────────────────────────────
MEMORY_ENABLED=true
TA_CACHE_STRATEGY=file                 # file | integrated（integrated 需可选装的 pymongo/redis）
USE_MONGODB_STORAGE=false

# ── 持仓分析（功能：analyze_holdings）─────────────────────────────
HOLDINGS_PROVIDER=manual               # manual | joinquant | qmt

# ── 市场简报（功能：market_brief）─────────────────────────────────
BRIEF_LLM_MODEL=deepseek-chat
# 定时推送（可选，靠适配器常驻调度）：
BRIEF_PUSH_ENABLED=false
BRIEF_PUSH_CHANNELS=
SERVERCHAN_SENDKEY=
WECOM_WEBHOOK_KEY=
BRIEF_SCHEDULE_ENABLED=false
BRIEF_PRE_MARKET_TIME=08:50
BRIEF_POST_MARKET_TIME=15:30

# ── 运行 ──────────────────────────────────────────────────────────
ADAPTER_RUNNER=engine                 # engine | fake（fake 无引擎，用于联调）
TIMEZONE=Asia/Shanghai
PYTHONDONTWRITEBYTECODE=1
