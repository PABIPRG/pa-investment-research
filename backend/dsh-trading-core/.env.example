# dsh-trading-core 配置模板
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不会入库）
# 产品内通过 Profile 使用时，只在现有 Models 页面管理 Key；不要为产品使用复制或填写 backend .env。
# backend .env 仅用于 Python 独立启动或兼容开发，且宿主注入的进程环境变量优先。
# 完整可用的配置在旧项目 TradingAgents-CN/.env（含上游 app 用到的 MongoDB/Redis/定时同步等，
# 本插件只用下面这些子集；缺省项适配器会回退默认值）。

# ── LLM（DeepSeek，插件核心）──────────────────────────────────────
# 适配器用 openai 直连 DeepSeek，绕开 LangChain 层
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=true
# 引擎侧默认 provider 用 openai 兼容端点；engine_bridge 会显式覆盖为 DeepSeek
OPENAI_API_KEY=sk-你的key

# ── 风险偏好（全局默认档：conservative | balanced | aggressive）──
RISK_PROFILE=balanced

# ── A 股数据源 ────────────────────────────────────────────────────
DEFAULT_CHINA_DATA_SOURCE=akshare     # akshare | baostock | tushare
# TUSHARE_TOKEN=                        # 可选，tushare 数据源 token
# 国内行情站必须走直连（否则走代理会失败）
NO_PROXY=localhost,127.0.0.1,eastmoney.com,.eastmoney.com,gtimg.cn,sinaimg.cn,sinajs.cn,sina.com.cn,baostock.com

# ── 引擎记忆 / 缓存 ───────────────────────────────────────────────
MEMORY_ENABLED=true
TA_CACHE_STRATEGY=file                 # file | integrated（integrated 需可选装的 pymongo/redis）
USE_MONGODB_STORAGE=false

# ── 持仓分析（功能：analyze_holdings）─────────────────────────────
HOLDINGS_PROVIDER=manual               # manual | easytrader | qmt | joinquant
# easytrader（券商客户端 GUI 自动化，零券商门槛；同花顺内核 80+ 家 / 通达信内核 60+ 家）
# 推荐流程：env\Scripts\python.exe holdings_cli.py detect 自动发现本机客户端并生成配置
EASYTRADER_BROKER=                     # 券商档案 id（如 pingan/guojin/yinhe，全表见 holdings_cli.py detect --list）
EASYTRADER_CLIENT_TYPE=thstrader       # thstrader(同花顺内核) | tdxtrader(通达信内核)；设置 BROKER 时被其覆盖
EASYTRADER_CLIENT_PATH=                # 下单程序路径（如 C:\平安证券\同花顺版\xiadan.exe，detect 自动发现）
# QMT（迅投 miniQMT/xtquant，需券商开通，10万门槛）
QMT_ACCOUNT_ID=                        # 券商资金账号
QMT_SESSION_ID=888888                  # xtquant 会话 ID
RISK_EVENT_DEADLINE=0.35                # 风险预警等待 market-watch 的秒数
EVENT_FAILURE_BACKOFF=2                 # 无 stale 时上游失败的短退避秒数
RISK_PORTFOLIO_CACHE_TTL=2              # 组合风险进程内短缓存秒数

# ── 市场简报（功能：market_brief）─────────────────────────────────
BRIEF_LLM_MODEL=deepseek-chat
# 定时推送（可选，靠适配器常驻调度）：
BRIEF_PUSH_ENABLED=false
BRIEF_PUSH_CHANNELS=
SERVERCHAN_SENDKEY=
WECOM_WEBHOOK_KEY=
BRIEF_SCHEDULE_ENABLED=false
BRIEF_PRE_MARKET_TIME=08:50
BRIEF_POST_MARKET_TIME=15:30

# ── 运行 ──────────────────────────────────────────────────────────
ADAPTER_RUNNER=engine                 # engine | fake（fake 无引擎，用于联调）
TIMEZONE=Asia/Shanghai
PYTHONDONTWRITEBYTECODE=1

# ── 自进化 v2 行为开关 ─────────────────────────────────────────────
# 下列键在代码里默认 true（v2 行为已作为默认），此处注释仅为显式关闭/覆盖用：
# 不设任何键 → 全部走代码默认（见 adapter/config.py 自进化 v2 段）。
#
# 生态位族内换 kind / 跨事件池换标的（P2）：
EVOLVE_MIGRATION_ENABLED=true
# 有性繁殖 crossover / 归因引导有向变异（P3）：
EVOLVE_RECOMBINE_ENABLED=true
EVOLVE_GUIDED_PRUNE_ENABLED=true
# 种群治理：生态位相关性去重 / 停滞让位 / 退役基因存档（P4）：
EVOLVE_CORRELATION_ENABLED=true
EVOLVE_STAGNANT_ENABLED=true
EVOLVE_ARCHIVE_ENABLED=true
# 运行时自适应·冬眠（P5）：
EVOLVE_HIBERNATE_ENABLED=true
# 进化反馈到假设生成先验（P6）：
PRIOR_REPLAY_ENABLED=true
#
# 刻意保持默认 false（激进/偏置，暂不默认开）：
# EVOLVE_REVIVE_ENABLED=false   # 退役基因当 regime 切回擅长档时自动召回复测
# REGIME_GATE_ENABLED=false     # shadow 是否按 regime_gate.allow 门控选股
# EVOLVE_FITNESS_MODE=log       # log(≡v1 绝对净值) | relative | excess；log 为保守默认
