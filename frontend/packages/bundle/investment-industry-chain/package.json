{
  "name": "@deepseek-ai/dsh-investment-industry-chain-bundle",
  "description": "Investment research industry-chain profile bundle",
  "version": "0.1.0-rc.7",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/investment-industry-chain"
  },
  "type": "module",
  "main": "lib/index.js",
