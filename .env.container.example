# Copy to .env.container and keep that file outside version control.
DSH_IMAGE=pa-investment-research:local
PORT=3080
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai
# 自动自进化默认开启。关闭请在持久卷的
# investment-research/trading-core/user-config/backend.env 设置 CLOSED_LOOP_ENABLED=false，
# 再重启 investment。仅在本文件写此变量不会传入后端；详见 docs/云端部署指南.md。
# 管理员修改用户名后，重新创建对应 Compose 项目中的 investment 服务。
DSH_WEB_ADMIN_USERNAME=admin
# 仅首次初始化；当前密码保存在该实例数据卷 /var/lib/dsh/web-auth/password.hash。
DSH_WEB_ADMIN_PASSWORD_HASH_FILE=/absolute/path/to/web-admin-password.hash
DSH_WEB_TRUSTED_HOSTS=research.example.com
DSH_WEB_TRUSTED_PROXIES=172.17.0.1

# 观察室可选配置：默认关闭；这些是服务端变量，不能写入 Vercel 的 VITE_*。
# 仅在批准公开后填写精确来源，例如 https://pair-observe.xiexin.dev（不带末尾 /）。
DSH_PUBLIC_OBSERVATORY_ORIGIN=
# 操作公开起点须含时区；详情会公开证券代码、变更前后数量和成本价。
DSH_PUBLIC_OBSERVATORY_OPERATIONS_SINCE=
# 报告活动只公开固定类型、时间、状态和摘要；留空关闭研究活动。
DSH_PUBLIC_OBSERVATORY_RESEARCH_SINCE=
# trading-core 到 market-watch 的容器内部地址。
MW_URL=http://127.0.0.1:8100
# 逐份批准的完整账户快照 ID 数组；持仓市值不等于完整账户总权益。
DSH_PUBLIC_OBSERVATORY_SNAPSHOT_IDS=[]
# 仅内部快照写入需要；只读观察室无需配置令牌。
DSH_PUBLIC_OBSERVATORY_WRITE_TOKEN=
